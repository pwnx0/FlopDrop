# ==============================================================================
# FLOP Network Community Bot Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Network Selection (devnet | testnet)
# ------------------------------------------------------------------------------
# Switch between devnet and testnet simply by setting FLOP_NETWORK.
FLOP_NETWORK=devnet

# ------------------------------------------------------------------------------
# 2. Endpoints (Auto-configured based on FLOP_NETWORK, override if using custom nodes)
# ------------------------------------------------------------------------------
# Devnet Defaults:
#   RPC:     https://rpc.devnet.flop.network
#   Gateway: https://api.flop.network/v1
# Testnet Defaults:
#   RPC:     https://rpc.testnet.flop.network
#   Gateway: https://api.testnet.flop.network/v1
FLOP_RPC_URL=https://rpc.devnet.flop.network
FLOP_GATEWAY_URL=https://api.flop.network/v1
FLOP_FAUCET_URL=https://faucet.flop.network/fund

# ------------------------------------------------------------------------------
# 3. Account / Wallet Credentials
# ------------------------------------------------------------------------------
# Raw 32-byte Ed25519 private key in hex (64 hex characters, with or without '0x').
# Run `python main.py --generate-wallet` to generate a fresh wallet key.
FLOP_PRIVATE_KEY=your_private_key_hex_here

# ------------------------------------------------------------------------------
# 4. Inference Model Selection
# ------------------------------------------------------------------------------
# Model to execute on FLOP Network (e.g. qwen/qwen2.5-0.5b-instruct, qwen/qwen3-14b)
FLOP_MODEL=qwen/qwen2.5-0.5b-instruct

# ------------------------------------------------------------------------------
# 5. Optional AI Model for Task Building / Synthesis
# ------------------------------------------------------------------------------
# If you want an AI model (like Groq or OpenAI) to synthesize and refine trade questions:
# Set AI_BUILDER_ENABLED=true and provide an API key.
# If false, the bot uses the built-in deterministic combinatorial scenario engine.
AI_BUILDER_ENABLED=false
AI_BUILDER_PROVIDER=groq
AI_BUILDER_API_KEY=
AI_BUILDER_MODEL=llama-3.3-70b-versatile
AI_BUILDER_ENDPOINT=https://api.groq.com/openai/v1

# ------------------------------------------------------------------------------
# 6. Bot Behavior & Execution Settings
# ------------------------------------------------------------------------------
# Loop interval in seconds between tasks (used in --loop mode)
LOOP_INTERVAL_SECONDS=30.0

# Minimum balance (FLOP) required before executing tasks
MIN_REQUIRED_BALANCE_FLOP=1.0

# Maximum turns per session
MAX_TURNS_PER_SESSION=5
